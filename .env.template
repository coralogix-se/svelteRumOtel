# Python API and Node (npm run start) send OTLP traces/logs to a local OpenTelemetry Collector.
# Point the collector at Coralogix with your Send-Your-Data key (see otel-collector-config.yaml: CORALOGIX_PRIVATE_KEY).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true

# Local collector → Coralogix (US2). Same Send-Your-Data key type as OpenTelemetry in Coralogix UI.
# Referenced by otel-collector-config.yaml exporters; not read by backend/main.py for OTLP export.
CORALOGIX_PRIVATE_KEY=your_coralogix_otel_key_here

# --- Guardrails (Python /api/chat) — separate product from OTLP collector export ---
# Your OTLP ingestion key does NOT work on the Guardrails REST API (you get 403).
# Create a Guardrails API key in Coralogix and set it here (or use CX_GUARDRAILS_TOKEN). Same region as endpoint.
# false = call Guard API in observe-only (log violations, do not block). true = enforce (block on violations).
GUARDRAILS_ENABLED=false
CORALOGIX_GUARDRAILS_KEY=your_coralogix_guardrails_key_here
# CX_GUARDRAILS_TOKEN=
# CX_GUARDRAILS_ENDPOINT=https://api.us2.coralogix.com/api/v1/guardrails/guard

# Coralogix RUM (browser real user monitoring) - region US2
# VITE_ prefix exposes to client; get from Coralogix RUM setup
VITE_CORALOGIX_RUM_KEY=your_coralogix_rum_key_here
# Optional in Docker/K8s: runtime RUM key without rebuild (overrides empty VITE_ if set)
# PUBLIC_CORALOGIX_RUM_KEY=

# Google Gemini 2.5 Flash Lite API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Pixabay image search (https://pixabay.com/api/docs/). Without this, chat uses Wikimedia Commons (no key).
# PIXABAY_API_KEY=

# Python chat API base URL for the browser. For local dev, leave unset so chat uses same-origin
# /api (Vite proxies to port 8000). Set only if you need a remote API or non-proxy setup.
# VITE_CHAT_API_URL=http://localhost:8000

# Dual-stack RUM harness (npm run test:rum:both): each URL must publish its own PUBLIC/VITE Coralogix RUM key (US2 vs EU1 stacks).
# BASE_URL_TEAM_A=https://chat-team-a.example.com
# BASE_URL_TEAM_B=https://chat-team-b.example.com
# Optional parallel Puppeteer: RUM_HARNESS_PARALLEL=1
# Milliseconds between harness runs (rum-harness-loop). Default 300000 (5 min); use 120000 for denser local traffic.
# RUM_HARNESS_LOOP_INTERVAL_MS=300000
# RUM_HARNESS_RUM_FLUSH_MS=5000
