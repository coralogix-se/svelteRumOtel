# OTLP to local OpenTelemetry Collector (see repo root otel-collector-config.yaml + CORALOGIX_PRIVATE_KEY there).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# --- Guardrails (Python /api/chat) — not the same as the collector OTLP key ---
# The Send-Your-Data OTLP key does not authenticate the Guardrails HTTP API (expect 403 if you try).
# Use a Guardrails key from Coralogix (see AI Guardrails docs). Optional: CX_GUARDRAILS_TOKEN instead of below.
# true = block on violations. false = observe-only (still calls Guard API if a key is set).
GUARDRAILS_ENABLED=false
CORALOGIX_GUARDRAILS_KEY=your_coralogix_guardrails_key_here
# CX_GUARDRAILS_TOKEN=
# Guardrails REST API (not OTLP ingress — wrong host returns HTTP 404).
# CX_GUARDRAILS_ENDPOINT=https://api.us2.coralogix.com/api/v1/guardrails/guard
# If the Guardrails API is down or misconfigured, set true to allow chat without prompt/response checks (dev only).
# GUARDRAILS_FAIL_OPEN_ON_UNAVAILABLE=false
# Optional: fraction of chat requests that use synthetic demo text to exercise guardrails (default 0.03).
# GUARDRAIL_DEMO_PROBABILITY=0.03

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: capture prompts/responses (NO_CONTENT | SPAN_ONLY | EVENT_ONLY | SPAN_AND_EVENT)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
